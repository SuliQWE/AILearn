# Supabase: Project Settings -> API
# ВАЖНО: адрес БЕЗ /rest/v1/ на конце
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) или старый anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Только на сервере! Никогда не добавляйте NEXT_PUBLIC_ к этому ключу.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Gemini: https://aistudio.google.com/apikey  (только на сервере)
GEMINI_API_KEY=
# Модель можно менять без правки кода
GEMINI_MODEL=gemini-flash-latest

# Публичный адрес сайта (для ссылки и QR-кода). Локально: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Демо-вход для жюри: кнопки на странице /teacher создают и подставляют тестовые аккаунты. После показа поставьте false.
DEMO_ENABLED=true
